# Template for XDC Launchpad Hardhat environment variables.

# To use this template, copy this file, rename it .env, and fill in the values.

# If not set, we provide default values (check `hardhat.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME

# ===== ETHEREUM NETWORKS =====
# Alchemy API key for Ethereum networks (mainnet, sepolia, etc.)
ALCHEMY_API_KEY=

# Etherscan API key for contract verification
ETHERSCAN_V2_API_KEY=

# ===== XDC NETWORKS =====
# XDC mainnet RPC URL (optional, defaults to public RPC)
XDC_RPC_URL=https://rpc.xinfin.network

# XDC testnet (Apothem) RPC URL (optional, defaults to public RPC)
XDC_TESTNET_RPC_URL=https://rpc.apothem.network

# XDC Explorer API key for contract verification (get from https://xdcscan.io)
XDCSCAN_API_KEY=

# ===== DEPLOYMENT =====
# Deployer private key (encrypted)
# Don't fill this value manually, run yarn generate to generate a new account
# or yarn account:import to import an existing PK
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# ===== FORKING =====
# Enable mainnet forking for testing (set to "true" to enable)
MAINNET_FORKING_ENABLED=false

# ===== INFURA (Alternative to Alchemy) =====
# Uncomment and use if you prefer Infura over Alchemy
# INFURA_API_KEY=

# ===== PRIVATE KEYS =====
# For development only - never commit real private keys
# These are auto-generated for local development
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ===== ADDITIONAL NETWORKS =====
# Add your own network configurations here if needed
# CUSTOM_NETWORK_RPC_URL=
# CUSTOM_NETWORK_API_KEY=
